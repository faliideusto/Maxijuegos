[resource]
script = ExtResource("1")
display_name = "Puntería"
description = "¡Un tiro, una diana!"
instructions = "Dispara a las dianas antes de que desaparezcan: cuanto más cerca del centro, más puntos. Las doradas duran la mitad pero valen el triple. Encadena aciertos para subir el multiplicador; fallar quita 25 puntos y rompe la racha. Ratón: apunta y clic. Teclado o mando: mueve la mirilla y pulsa tu botón de acción. Todos tenéis las mismas dianas y no veréis a los demás."
