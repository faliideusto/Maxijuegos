[resource]
script = ExtResource("1")
display_name = "Mecha Corta"
description = "Petardos, cajas y último en pie."
instructions = "Estáis en un laberinto lleno de cajas. Muévete con WASD / flechas / stick y planta un petardo con tu botón de acción: estalla en cruz a los 2 segundos y pico, revienta cajas y elimina a quien pille (¡a ti también!). Algunas cajas esconden mejoras: verde = un petardo más, amarilla = más alcance, azul = más velocidad. Si se acaba el tiempo, el tablero se va cerrando desde fuera. Gana el último en pie."
min_players = 2
max_players = 8
