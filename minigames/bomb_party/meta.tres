[resource]
script = ExtResource("1")
display_name = "Bomba de Palabras"
description = "¡Que no te explote!"
instructions = "Te pasan la bomba con unas letras (por ejemplo CAS): escribe una palabra en español que las contenga seguidas (CASA, CASCO, ESCASO...) y pulsa Enter. No se pueden repetir palabras. La mecha es secreta y no se reinicia: quien tenga la bomba cuando explote queda eliminado, y se sigue con los que quedan. Gana el último que sobrevive. Se juega con el teclado."
