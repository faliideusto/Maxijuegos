[resource]
script = ExtResource("1")
display_name = "Carrera de Ruinas"
description = "¡Salta por las ruinas hasta la meta!"
instructions = "Parkour en 3D sobre unas ruinas flotantes: todos corréis a la vez y os veis; la cámara va detrás de tu personaje. Muévete con WASD o las flechas y salta con ESPACIO o CLIC. Hay zonas distintas: piedras sueltas, una viga estrecha, escaleras, plataformas que se mueven, una barra giratoria y columnas. Si caes a la niebla vuelves al último punto de control. Gana quien llegue antes a la meta; el minimapa te muestra el recorrido y a los demás."
min_players = 2
max_players = 8
approx_duration = 60.0
scene = ExtResource("2")
accent_color = Color(1, 0.62, 0.25, 1)
execution_mode = 0
max_duration = 0.0
music = &"run"
short_text = "Muévete con WASD y salta con ESPACIO o CLIC. Si caes, vuelves al último punto."
