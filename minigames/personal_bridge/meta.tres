[resource]
script = ExtResource("1")
display_name = "Puente Personal"
description = "¿Egoísta o no?"
instructions = "Estáis todos en una plataforma rodeada de torres, cada una con su puente y su premio (+1, +2 o el oro +3). Tienes unos segundos para elegir puente en secreto: haz clic en él con el ratón (o apunta con WASD / flechas / stick). Puedes cambiar hasta que se acabe el tiempo. Luego todos cruzan a la vez: si más de uno eligió el mismo puente, se viene abajo y os quedáis sin nada. 3 rondas; gana quien más puntos sume."
min_players = 2
max_players = 8
approx_duration = 40.0
