[resource]
script = ExtResource("1")
display_name = "Columpio de Lengua"
description = "¡Que no te alcance la niebla!"
instructions = "Mantén tu botón de acción para agarrarte con la lengua al gancho más cercano de delante y suéltalo para salir volando. Encadena ganchos sobre el pantano: los dorados aguantan, los rojos se rompen enseguida. Una niebla venenosa te persigue y cada vez va más rápido. Solo tienes un intento: gana quien llegue más lejos. No verás a los demás."
min_players = 2
max_players = 8
approx_duration = 45.0
scene = ExtResource("2")
accent_color = Color(0.45, 0.9, 0.35, 1)
execution_mode = 1
max_duration = 130.0
music = &"tongue"
short_text = "Mantén para agarrarte y suelta para salir volando. ¡Huye de la niebla!"
