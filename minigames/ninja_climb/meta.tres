[resource]
script = ExtResource("1")
display_name = "Ninja Trepador"
description = "¡Salta de pared en pared!"
instructions = "Sube saltando de una pared a otra. Los puntos de delante de tu ninja marcan la dirección del próximo salto y oscilan solos: pulsa tu botón de acción (o clic) justo cuando apunten donde quieres. Más vertical = más altura. Evita los pinchos y no te dejes caer: sin pulsar, el ninja resbala por la pared. Gana quien llegue más alto en 45 s. Todos tenéis las mismas paredes y no veréis a los demás."
min_players = 2
