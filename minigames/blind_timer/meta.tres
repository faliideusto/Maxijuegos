[resource]
script = ExtResource("1")
display_name = "Crono a Ciegas"
description = "¿Sabes contar sin mirar?"
instructions = "Hay un cronómetro en el centro y un tiempo objetivo al azar (de 5 a 15 segundos). El crono empieza a contar, pero al poco rato desaparece: sigue contando de cabeza y pulsa tu botón de acción justo en el objetivo. Solo puedes parar una vez y nadie ve su tiempo hasta el final. Gana quien se quede más cerca, por arriba o por abajo."
