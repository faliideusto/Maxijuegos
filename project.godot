; Archivo de configuración del proyecto (Godot 4).
config_version=5

[application]

config/name="MaxiJuegos"
config/description="Party game multijugador de minijuegos (2-8 jugadores)."
run/main_scene="res://ui/screens/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

; En web, Godot mezcla el audio él mismo (como en escritorio). El modo "Sample" por defecto deja muda la
; música y los efectos del juego (buses creados por código y streams generados en tiempo de ejecución).
general/default_playback_type.web=0
; El audio se mezcla en el hilo principal: con más margen (ms) aguanta los tirones sin cortarse.
driver/output_latency.web=120

[autoload]

MinigameRegistry="*res://autoload/minigame_registry.gd"
InputManager="*res://autoload/input_manager.gd"
NetworkManager="*res://autoload/network_manager.gd"
Lobby="*res://autoload/lobby.gd"
GameManager="*res://autoload/game_manager.gd"
Transition="*res://autoload/transition.gd"
DevCli="*res://autoload/dev_cli.gd"
Audio="*res://autoload/audio_manager.gd"
TouchControls="*res://autoload/touch_controls.gd"
Display="*res://autoload/display.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; En web se dibuja a la resolución de la ventana del navegador, no a la física (en pantallas retina/4K sería
; 4 veces más píxeles y los juegos 3D irían a tirones).
window/dpi/allow_hidpi.web=false

[gui]

theme/custom="res://ui/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_2d=2
